# Koverly backend configuration. Copy to `.env` and fill in real values.
# NEVER commit a populated .env file.

# --- Core ---
ENV=development            # development | test | production
DEBUG=false

# --- Security ---
# REQUIRED in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Local default (SQLite). Production example:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/koverly
DATABASE_URL=sqlite+aiosqlite:///./koverly.db

# --- Storage ---
STORAGE_BACKEND=local      # local | s3
STORAGE_LOCAL_ROOT=./storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
SIGNED_URL_TTL_SECONDS=300

# --- Uploads ---
MAX_UPLOAD_BYTES=15728640
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png

# --- OCR (self-hosted Tesseract) ---
# Reads scanned policy copies (PDFs without a text layer, JPG/PNG). Requires
# the `tesseract-ocr` and `poppler-utils` system packages (installed in the
# Docker images). If unavailable, documents fail with an explicit reason.
OCR_ENABLED=true
OCR_LANGUAGES=eng
OCR_DPI=200
OCR_MAX_PAGES=10
OCR_PAGE_TIMEOUT_SECONDS=60
OCR_MIN_TEXT_CHARS=80
# Optional absolute path to the tesseract binary (default: found on PATH).
TESSERACT_CMD=

# --- AI ---
# "null" = deterministic local provider (no external calls, no fabrication).
# "openai" = any OpenAI-compatible endpoint.
AI_PROVIDER=null
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_TIMEOUT_SECONDS=60

# --- Notifications ---
NOTIFICATION_BACKEND=noop  # noop | webhook
NOTIFICATION_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120
