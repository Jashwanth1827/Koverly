# Koverly backend configuration. Copy to `.env` and fill in real values.
# NEVER commit a populated .env file.

# --- Core ---
ENV=development            # development | test | production
DEBUG=false

# --- Security ---
# REQUIRED in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Local default (SQLite). Production example:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/koverly
DATABASE_URL=sqlite+aiosqlite:///./koverly.db

# --- Storage ---
STORAGE_BACKEND=local      # local | s3
STORAGE_LOCAL_ROOT=./storage
# For S3: set bucket/region and install boto3. URLs are presigned GETs.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
SIGNED_URL_TTL_SECONDS=300

# --- Uploads ---
MAX_UPLOAD_BYTES=15728640
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv,text/markdown,text/plain

# --- OCR (optional, install with: pip install -e ".[ocr]") ---
# "auto" uses RapidOCR when installed, "rapidocr" requires it, "none" disables.
# Runs fully offline; documents never leave the machine.
OCR_BACKEND=auto
OCR_MIN_TEXT_CHARS=30
OCR_MIN_CONFIDENCE=0.3
OCR_PDF_DPI=200
OCR_MAX_PAGES=200

# --- AI ---
# "null" = deterministic local provider (no external calls, no fabrication).
# "openai" = any OpenAI-compatible endpoint.
AI_PROVIDER=null
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_TIMEOUT_SECONDS=60

# --- Notifications ---
NOTIFICATION_BACKEND=noop  # noop | smtp | webhook
NOTIFICATION_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address; defaults to SMTP_USER when empty.
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# --- Reminder scheduler ---
# In-process scheduler for single-instance deployments. Disable it when
# running multiple workers and drive reminders from an external cron instead.
REMINDER_SCHEDULER_ENABLED=true
REMINDER_CHECK_INTERVAL_MINUTES=15
# Required for POST /api/v1/system/run-reminders. Leave empty to disable it.
SCHEDULER_TOKEN=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120
